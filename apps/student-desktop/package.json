{
  "name": "@classroom-desk/student-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Student desktop widget for Classroom Desk",
  "author": "School IT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/maybe-dev.mjs",
    "dev:electron": "FORCE_ELECTRON=1 node scripts/maybe-dev.mjs",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@classroom-desk/i18n": "*",
    "@classroom-desk/shared": "*",
    "bcryptjs": "^3.0.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "school.classroom.desk",
    "productName": "Classroom Desk",
    "electronVersion": "34.5.8",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClassroomDesk-Setup-${version}.${ext}",
      "signExecutable": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Classroom Desk",
      "uninstallDisplayName": "Classroom Desk（课堂管理）",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "resources/config.json",
        "to": "config.json"
      },
      {
        "from": "build/FIRST_RUN_GUIDE.html",
        "to": "FIRST_RUN_GUIDE.html"
      }
    ],
    "protocols": [
      {
        "name": "Classroom Desk",
        "schemes": [
          "classroom-desk"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  }
}
