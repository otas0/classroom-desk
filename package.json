{
  "name": "classroom-desk",
  "private": true,
  "version": "0.1.8",
  "description": "School classroom homework, attendance, and points toolkit",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-electron-macos.js",
    "dev:student": "npm run dev --workspace=@classroom-desk/student-desktop",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build:student": "npm run build --workspace=@classroom-desk/student-desktop",
    "build:teacher": "npm run build --workspace=@classroom-desk/teacher-web",
    "build:web": "npm run build:teacher",
    "dev:server": "npm run dev --workspace=@classroom-desk/server",
    "dev:teacher": "npm run dev --workspace=@classroom-desk/teacher-web",
    "start:server": "npm run start --workspace=@classroom-desk/server",
    "start:classroom": "node scripts/start-classroom.mjs",
    "test:server": "npm run test --workspace=@classroom-desk/server",
    "sync:permissions": "node scripts/sync-permissions-md.mjs",
    "test:e2e": "playwright test",
    "test:e2e:bulk": "playwright test e2e/bulk-ui.spec.ts e2e/bulk-ops.spec.ts e2e/q-recycle-purge.spec.ts e2e/ops-polish.spec.ts e2e/ops-v015.spec.ts e2e/ops-v016.spec.ts",
    "test:e2e:rbac": "playwright test e2e/assistant-rbac.spec.ts e2e/buzz-ws.spec.ts e2e/session-kick.spec.ts e2e/session-kick-ui.spec.ts e2e/audit-detail.spec.ts e2e/permissions-doc.spec.ts",
    "fonts:cjk": "node scripts/fetch-cjk-font.mjs",
    "dist:win": "npm run dist:win --workspace=@classroom-desk/student-desktop",
    "typecheck:server": "npm run typecheck --workspace=@classroom-desk/server",
    "backup:db": "bash scripts/backup-db.sh",
    "prepare:live": "node scripts/prepare-live-classroom.mjs",
    "prepare:usb": "bash scripts/prepare-usb-pack.sh",
    "copy:usb": "bash scripts/copy-usb-release.sh",
    "verify:1plus1": "node scripts/local-1plus1-verify.mjs",
    "verify:usb-host": "node scripts/verify-usb-host.mjs",
    "verify:exit-lock-packaged": "node scripts/verify-exit-lock-packaged.mjs",
    "verify:exit-lock-audit": "node scripts/verify-exit-lock-audit.mjs",
    "smoke:dev-stack-api-restart": "node scripts/dev-stack-api-restart-smoke.mjs",
    "test:month": "node --import tsx/esm apps/server/src/test/localMonthRange.test.ts",
    "test:confirm-modal-a11y": "tsx apps/teacher-web/src/confirmModalA11y.test.ts",
    "test:principal-ws": "tsx apps/teacher-web/src/principalWsBackoff.test.ts",
    "archive:live-shield": "node scripts/archive-live-shield-evidence.mjs",
    "check:live-evidence": "node scripts/check-live-evidence-sanitized.mjs",
    "test:live-evidence": "node scripts/check-live-evidence-sanitized.test.mjs",
    "diff:walled-garden": "node scripts/opnsense-walled-garden-diff.mjs",
    "verify:exam-box-api-ready": "node scripts/verify-exam-box-api-ready.mjs",
    "generate:sku-html": "node scripts/generate-sku-html.mjs",
    "check:nightly-flake": "node scripts/check-nightly-flake.mjs",
    "check:git-remote": "node scripts/check-git-remote-host.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "init:c2-evidence": "bash scripts/init-c2-evidence-dir.sh",
    "verify:c2-evidence": "node scripts/verify-c2-evidence.mjs",
    "ops:webhook-dry-run": "node scripts/ops-webhook-dry-run.mjs",
    "cleanup:e2e-classes": "node scripts/cleanup-e2e-classes.mjs",
    "verify:exam-box-proxy-live": "node scripts/verify-exam-box-proxy-live.mjs",
    "verify:install-teacher": "node scripts/verify-install-teacher.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "playwright": "^1.65.0"
  }
}
