# Classroom Desk — school LAN HTTPS reverse proxy (Caddy).
# Terminate TLS with school CA / internal cert; proxy to teacher host :8787.
# Students set apiBase to https://classroom.school.local (no :8787).

classroom.school.local {
	tls /etc/caddy/certs/classroom.crt /etc/caddy/certs/classroom.key

	# WebSocket (presence / principal / buzz)
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @ws 127.0.0.1:8787

	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
