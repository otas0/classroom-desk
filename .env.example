# === Pilot go-live secrets (docs/PILOT_GO_LIVE.md) ===
# Generate: openssl rand -hex 32
# Required in production (≥32 chars; no placeholders). Dev: ephemeral if unset.
JWT_SECRET=replace-with-openssl-rand-hex-32
# Strongly recommended (audit HMAC + compliance pack seal). Falls back to JWT_SECRET if empty.
AUDIT_HMAC_KEY=

# Optional bootstrap (first run only)
ADMIN_PASSWORD=
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=
DEFAULT_CLASS_CODE=

PORT=8787
HOST=0.0.0.0
# CLASSROOM_DESK_DATA_DIR=

# NODE_ENV=production   # enables strong-secret + TLS login checks when max_secrecy on

# Shield: off | http | opnsense | unifi  (no mock; default off = honest「网关未断」)
# Campus SKU: set one of opnsense|unifi|http. Local labs: npm run lab:shield|lab:opnsense|lab:unifi
# CLASSROOM_DESK_SHIELD=http
# CLASSROOM_DESK_SHIELD_URL=http://127.0.0.1:8791
# OPNSENSE_URL=https://192.168.1.1
# OPNSENSE_API_KEY=
# OPNSENSE_API_SECRET=
# OPNSENSE_ALIAS=classroom_desk_block
# OPNSENSE_ALLOW_ALIAS=classroom_desk_allow
# UNIFI_URL=https://192.168.1.1
# UNIFI_USER=
# UNIFI_PASS=
# UNIFI_SITE=default

# DeskDNS (单网校包): CLASSROOM_DESK_DNS=1  + DHCP DNS → teacher host
# CLASSROOM_DESK_DNS=1
# Campus federation hub (optional; blocked under max-secrecy airgap):
# CLASSROOM_DESK_FEDERATION_HUB=https://hub:8790/api/v1/federation/ingest
# CLASSROOM_DESK_FEDERATION_HUB_TOKEN=same-as-FEDERATION_HUB_TOKEN-on-hub
# CLASSROOM_DESK_DNS_PORT=5353
# Production port 53: see docs/DESKDNS_PORT53.md (systemd AmbientCapabilities / setcap)
# CLASSROOM_DESK_PORTAL_HOST=teacher.school.local
# HTTPS apiBase for clients: see docs/TLS_REVERSE_PROXY.md (do not expose :8787 publicly)

# Portal: require gateway-signed SSID (reject unsigned)
# CLASSROOM_DESK_PORTAL_SSID_REQUIRE_SIG=1
# Unmapped SSID/CIDR: default hold (block). Soft-allow only if explicitly set:
# CLASSROOM_DESK_PORTAL_UNMAPPED=allow

# Portal OTP delivery (roster contact_email / contact_phone preferred)
# CLASSROOM_DESK_EMAIL_WEBHOOK=
# CLASSROOM_DESK_PORTAL_OTP_TO=
# CLASSROOM_DESK_SMS_WEBHOOK=

# Frontends
VITE_API_BASE=http://127.0.0.1:8787

# Optional backup sync to mounted school NAS / network drive
# CLASSROOM_DESK_BACKUP_DIR=
# CLASSROOM_DESK_NAS_DIR=/Volumes/SchoolNAS/classroom-desk
# CLASSROOM_DESK_BACKUP_KEEP_DAYS=14

# Windows code signing for electron-builder (optional)
# CSC_LINK=/path/to/cert.pfx
# CSC_KEY_PASSWORD=
